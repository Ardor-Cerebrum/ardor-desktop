+Napi::Value InstallReadyUpdate(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  void (^work)(void) = ^{
+    if (g_userDriver == nil || g_userDriver.readyToInstallReply == nil) return;
+    void (^reply)(SPUUserUpdateChoice) = g_userDriver.readyToInstallReply;
+    g_userDriver.readyToInstallReply = nil;
+    reply(SPUUserUpdateChoiceInstall);
+  };
+
+  if ([NSThread isMainThread]) {
+    work();
+  } else {
+    dispatch_async(dispatch_get_main_queue(), work);
+  }
+  return env.Undefined();
+}
+
+Napi::Value TakeEvents(const Napi::CallbackInfo &info) {
+  Napi::Env env = info.Env();
+  __block NSArray<NSDictionary<NSString *, id> *> *events = nil;
+  void (^work)(void) = ^{
+    events = [g_eventQueue copy] ?: @[];
+    [g_eventQueue removeAllObjects];
+  };
+
+  if ([NSThread isMainThread]) {
+    work();
+  } else {
+    dispatch_sync(dispatch_get_main_queue(), work);
+  }
+
+  Napi::Array result = Napi::Array::New(env, events.count);
+  for (NSUInteger index = 0; index < events.count; index++) {
+    NSDictionary<NSString *, id> *event = events[index];
+    Napi::Object output = Napi::Object::New(env);
+    NSString *eventName = event[@"event"];
+    output.Set("event", Napi::String::New(env, eventName.UTF8String));
+    NSDictionary<NSString *, id> *data = event[@"data"];
+    if (data != nil) {
+      Napi::Object outputData = Napi::Object::New(env);
+      for (NSString *key in data) {
+        id value = data[key];
+        if ([value isKindOfClass:[NSString class]]) {
+          outputData.Set(key.UTF8String, Napi::String::New(env, [value UTF8String]));
+        } else if ([value isKindOfClass:[NSNumber class]]) {
+          outputData.Set(key.UTF8String, Napi::Number::New(env, [value doubleValue]));
+        }
+      }
+      output.Set("data", outputData);
+    }
+    result.Set(index, output);
+  }
+  return result;
+}
