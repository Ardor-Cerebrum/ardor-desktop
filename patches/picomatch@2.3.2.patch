+// SECURITY(ARD-3833): a glob star inside a repeated extglob can backtrack
+// exponentially even with one branch. Use the existing literal fallback for
+// these bodies. Escaped stars, character classes, and nested extglob openers
+// keep their existing handling. Remove after a verified upstream fix.
+const hasGlobStar = pattern => {
+  let bracket = false;
+  for (let i = 0; i < pattern.length; i++) {
+    const ch = pattern[i];
+    if (ch === '\\') {
+      i++;
+      continue;
+    }
+    if (ch === '[') {
+      bracket = true;
+    } else if (ch === ']') {
+      bracket = false;
+    } else if (!bracket && ch === '*' && pattern[i + 1] !== '(') {
+      return true;
+    }
+  }
+  return false;
+};
