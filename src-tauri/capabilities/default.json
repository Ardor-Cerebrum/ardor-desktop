{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Ardor Solutions desktop prototype.",
  "windows": ["main"],
  "webviews": ["main", "offscreen-browser-gpu-shell-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "process:allow-restart",
    "allow-automate-sidebar-browser",
    "allow-check-desktop-update",
    "allow-clear-browser-download-history",
    "allow-clear-browser-site-data",
    "allow-close-sidebar-browser",
    "allow-complete-auth-callback",
    "allow-control-sidebar-browser",
    "allow-delete-browser-credential",
    "allow-fill-browser-credential",
    "allow-get-browser-settings",
    "allow-get-auth-callback-status",
    "allow-get-pending-auth-callback",
    "allow-input-sidebar-browser",
    "allow-install-desktop-update",
    "allow-layout-sidebar-browser",
    "allow-list-browser-site-data",
    "allow-open-auth-url",
    "allow-open-browser-downloads",
    "allow-open-sidebar-browser",
    "allow-resolve-browser-credential-prompt",
    "allow-update-browser-preferences"
  ]
}
