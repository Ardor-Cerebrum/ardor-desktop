{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-preview",
  "description": "Minimal credential form notifications available to untrusted artifact previews.",
  "local": false,
  "remote": {
    "urls": ["https://*"]
  },
  "webviews": ["sidebar-browser-*", "offscreen-browser-gpu-preview-*"],
  "permissions": [
    "allow-browser-credential-form-detected",
    "allow-browser-credential-form-submitted"
  ]
}
